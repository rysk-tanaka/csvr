{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>rysk-tanaka/workflows#d5a542fb1ec5e23efa47ccf1a4f8dbbe8a92d71a", ":enablePreCommit"],
  "enabledManagers": ["cargo", "github-actions", "pre-commit", "custom.regex"],
  "packageRules": [
    {
      "description": "The shared preset automerges every minor/patch update; GitHub Actions updates stay manual here",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": false
    },
    {
      "matchDepNames": ["gpui", "gpui_platform"],
      "groupName": "gpui"
    }
  ]
}
