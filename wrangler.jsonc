// Cloudflare Workers Static Assets for the browser build. There is no Worker script: the site
// is the output of `trunk build --release` plus `_headers` from scripts/web-headers.mjs.
// .github/workflows/deploy-web.yml deploys it.
{
  "name": "csvr",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  // PR previews use preview aliases (`wrangler versions upload --preview-alias`).
  "preview_urls": true,
  "assets": {
    "directory": "./web/dist"
  }
}
